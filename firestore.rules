rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOfficer() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roleOverride', '') == 'officer'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('leadership', '') in ['president', 'vice_president', 'treasurer']);
    }

    function canManageOfficers() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('leadership', '') in ['president', 'treasurer'];
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || canManageOfficers();
      allow create, update, delete: if false;

      match /passkeys/{passkeyId} {
        allow read, write: if false;
      }
    }

    match /hackathonInterest/{uid} {
      allow read: if isSelf(uid) || isOfficer();
      allow create, update: if isSelf(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'interested', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.eventId == 'fqc-upcoming-hackathon'
        && request.resource.data.interested is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    match /system/leaderboardData {
      allow read: if signedIn();
      allow write: if false;
    }

    match /events/{eventId}/checkins/{uid} {
      allow read: if isSelf(uid) || isOfficer();
      allow write: if false;
    }

    match /passkeyCredentials/{credentialId} {
      allow read, write: if false;
    }

    match /passkeyChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
